# Copy to .env and fill in values before running.
# Generate SECRET_KEY:    openssl rand -hex 32
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=terratrain
POSTGRES_PASSWORD=terratrain
POSTGRES_DB=terratrain
DATABASE_URL=postgresql+asyncpg://terratrain:terratrain@postgres:5432/terratrain
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_MAX_AGENT_TURNS=6

# ─── Gemini ───────────────────────────────────────────────────────────────────
# Optional: Set your Gemini API key from Google AI Studio to use cloud models.
# If GEMINI_API_KEY is set, providers will automatically default to "gemini".
GEMINI_API_KEY=
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
GEMINI_CHAT_MODEL=models/gemini-3.5-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# ─── Intervals.icu ───────────────────────────────────────────────────────────
# Per-user API key + user ID are entered in the app (User Settings), not here.
INTERVALS_API_BASE_URL=https://intervals.icu/api/v1

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me
ENCRYPTION_KEY=change-me

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# ─── RAG ─────────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
DATA_DIR=/data

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
